# systemd 单元共用环境(复制到 /etc/spectre/spectre.env 后按机改)
SPECTRE_REPO=/opt/spectre
SPECTRE_DATA_DIR=/var/lib/spectre   # runtime/网关/四部署脚本统一读它; ⚠ systemd 单元 ReadWritePaths 也硬编码此路径(oob 为 /var/lib/spectre/oob)——迁移数据根需同改单元
# 沙箱驱动: local=免 Docker(宿主直跑); 缺省自动检测——有 docker 即建容器装工具链
# SPECTRE_SANDBOX_DRIVER=local
NODE_BIN=/usr/bin/node   # ⚠ 须为 Node ≥22(发行版默认常为 18——如 nvm/NodeSource 安装 22 后改指)
# 网关(runtime 令牌——与 backend/.env 的 INTERNAL_TOKEN 同值; dist 指向你的前端构建)
INTERNAL_TOKEN=change-me-same-as-backend-env
GATEWAY_DIST_DIR=/opt/spectre/console/dist
# 远程(非 localhost)纯 HTTP 测试时才打开; 生产走 TLS 保持关闭
# GATEWAY_INSECURE_COOKIE=1
# Temporal(可选)
TEMPORAL_BIN=/opt/temporal/temporal
