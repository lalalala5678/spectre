[Unit]
Description=SPECTRE agent runtime (pi sessions + bus)
After=network.target temporal-dev.service
StartLimitIntervalSec=0
Wants=temporal-dev.service

[Service]
EnvironmentFile=/etc/spectre/spectre.env
ExecStart=/bin/sh -c 'cd ${SPECTRE_REPO}/backend && exec ${NODE_BIN} agent-runtime.mjs'
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
