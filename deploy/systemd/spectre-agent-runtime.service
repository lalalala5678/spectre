[Unit]
Description=SPECTRE agent runtime (pi sessions + bus)
After=network.target temporal-dev.service
Wants=temporal-dev.service

[Service]
WorkingDirectory=/root/spectre/backend
ExecStart=/opt/node22/bin/node agent-runtime.mjs
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
