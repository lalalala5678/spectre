[Unit]
Description=SPECTRE private QA rack (real AV engines for c2-qa)
After=docker.service spectre-agent-runtime.service

[Service]
ExecStart=/usr/bin/python3 /var/lib/spectre/tools/c2/private-qa-server.py 8899
Environment=SPECTRE_SANDBOX_CONTAINER=spectre-sandbox
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
