[Unit]
Description=SPECTRE Temporal worker (AutoPwn orchestration)
After=network.target temporal-dev.service spectre-agent-runtime.service
StartLimitIntervalSec=0
Wants=temporal-dev.service spectre-agent-runtime.service

[Service]
EnvironmentFile=/etc/spectre/spectre.env
ExecStart=/bin/sh -c 'cd ${SPECTRE_REPO}/backend && exec ${NODE_BIN} worker.mjs'
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
