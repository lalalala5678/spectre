# runtime 必需(复制为 backend/.env)
INTERNAL_TOKEN=change-me-internal-token
# LLM 接入: 任意 OpenAI 兼容厂商均可——改三行(BASE_URL/KEY/MODEL)即切换
# 示例为智谱 GLM; DeepSeek/OpenAI/Moonshot/vLLM 自建等同理
LLM_API_KEY=change-me-llm-key
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_MODEL=glm-5.3
# 可选
TEMPORAL_ADDRESS=127.0.0.1:7233
