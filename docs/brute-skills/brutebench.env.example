# 爆破靶场凭据样例 — 复制为 brutebench.env(up.sh 按 BENCH_ENV 路径装载)后填真值
# benchmark 判定基线(ground truth)与靶标配置共用此文件, 不入库
BENCH_SSH_PW=change-me-ssh
BENCH_MYSQL_PW=change-me-mysql
BENCH_REDIS_PW=change-me-redis
BENCH_MINIO_PW=change-me-minio
BENCH_WEB_PLAIN_PW=change-me-plain
BENCH_WEB_MD5_PW=change-me-md5
BENCH_WEB_AES_PW=change-me-aes
BENCH_WEB_JWT_PW=change-me-jwt
BENCH_WEB_API_PW=change-me-api
BENCH_JWT_SECRET=change-me-jwt-secret
