#!/bin/bash
# fp-scan — SPECTRE 资产测绘统一指纹入口(四层指纹库,一条命令)
# 用法: fp-scan -l assets.txt [-o out.tsv] [--deep] [--max N]
#   assets: 域名或 URL 列表(每行一个)
#   默认层(轻): httpx 内置 wappalyzer + webappanalyzer 扩展库 + whatweb
#   --deep 层:  追加 nuclei 双指纹模板库(数量以 fetch-fingerprints 实际交付为准)
#               (每资产请求数↑,仅对存疑/高价值资产使用)
#   --max: whatweb 批量上限(默认 120,防慢)
# 输出: TSV — asset | status | title | server | apps(带版本) | fav | source
set -u
# R32D54: -h/--help 契约(家族统一); R32D57-NEW8: 先于 env-warn。
if [ "${1:-}" = '-h' ] || [ "${1:-}" = '--help' ]; then sed -n '2,12p' "$0"; exit 0; fi
# F28-bis: 显式 PATH——裸 docker exec 下 /usr/bin/httpx 是 python-httpx 库 CLI,
# 层1静默无产出。工具真身在 /opt/tools/bin(shared-tool 层)。
export PATH="/opt/tools/bin:$PATH"
# CS9-N5: 双运行位——容器内 /opt/tools(dicts 在挂载内), 宿主侧
# SPECTRE_DATA_DIR(与 py 工具 _data_root() 同语义; 此前不认 env)。
if [ -d /opt/tools/dicts ]; then FP_DIR=/opt/tools/dicts
else
  FP_DIR="${SPECTRE_DATA_DIR:-/var/lib/spectre}/tools/dicts"
  # R32D41-N1(对齐 py 工具守卫): 缺 env 静默回退生产数据根即警。
  [ -z "${SPECTRE_DATA_DIR:-}" ] && echo '[warn] SPECTRE_DATA_DIR 未设置, 回退缺省数据根 /var/lib/spectre(如非本意请先设置 SPECTRE_DATA_DIR)' >&2
fi
CFF=$FP_DIR/webappanalyzer.json
NT_DIR=$FP_DIR/../fingerprints
OUT=out.tsv; LIST=""; DEEP=0; MAX=120
FPTMP=$(mktemp -u /tmp/fp-scan.XXXXXX)  # R32D55-N4: 共享 /tmp/.fps.* 多实例碰撞→mktemp
trap "rm -f ${FPTMP}*" EXIT

while [ $# -gt 0 ]; do case "$1" in
  -l) LIST="$2"; shift 2;; -o) OUT="$2"; shift 2;;
  --deep) DEEP=1; shift;; --max) MAX="$2"; shift 2;;
  -h|--help) sed -n '2,12p' "$0"; exit 0;;
  *) echo "[fp-scan] 未知参数: $1(用法: -h)" >&2; exit 2;;
esac; done

# R32D55-N1: 供给守卫——缺件给可行动错误(此前 FileNotFoundError 裸栈)。
if [ ! -f "$CFF" ]; then
  echo "[fp-scan] 缺字典 $CFF——重跑 bash deploy/tools-sync.sh(交付 tools/dicts/); 仍缺则检查克隆完整性" >&2; exit 2
fi
if [ ! -d "$NT_DIR/nt-technologies" ]; then
  echo "[fp-scan] 缺指纹库 $NT_DIR/nt-technologies——运行 bash deploy/fetch-fingerprints.sh(约 45MB, 网络下载)" >&2; exit 2
fi
for eng in httpx whatweb; do
  command -v "$eng" >/dev/null 2>&1 || echo "[fp-scan][warn] 引擎 $eng 不在 PATH——对应层将跳过" >&2
done

# F28: 清理陈旧临时文件——此前残留的 l1/l2/l4 会被下一会话当新鲜结果合并(跨会话污染)
rm -f ${FPTMP}.l1.json ${FPTMP}.l2.json ${FPTMP}.l3.txt ${FPTMP}.l4.json ${FPTMP}.l4b.json ${FPTMP}.l4.log ${FPTMP}.l4b.log ${FPTMP}.out ${FPTMP}.in ${FPTMP}.ww
if [ -n "$LIST" ]; then cp "$LIST" ${FPTMP}.in; else cat > ${FPTMP}.in; fi
[ -s ${FPTMP}.in ] || { echo "fp-scan: empty input" >&2; exit 2; }
# R32D57-NEW11: 纯空白行不算输入(-s 只查字节非空)。
grep -q '[^[:space:]]' ${FPTMP}.in || { echo 'fp-scan: whitespace-only input' >&2; exit 2; }

echo "[fp-scan] layer1: httpx builtin wappalyzer..."
cat ${FPTMP}.in | httpx -silent -title -tech-detect -status-code \
  -web-server -content-type -favicon -follow-redirects -threads 15 -timeout 8 -json -o ${FPTMP}.l1.json >/dev/null 2>&1

# F28: PD httpx -cff 只认 "technologies" 键;旧版 webappanalyzer.json 用 "apps"
# → 层2 静默零输出。首次遇到自动转换缓存到 ${FPTMP}.cff.json。
CFF_OK="$CFF"
if [ -f "$CFF" ] && ! grep -q '"technologies"' <(head -c 4096 "$CFF"); then
  if [ ! -s ${FPTMP}.cff.json ]; then CFF_P="$CFF"; export CFF_P
    # CS31-P0: 此前 '${FPTMP}.cff.json' 在双引号 python -c 内不展开→写死
    # 字面路径。改环境变量传递。
    FPTMP="$FPTMP" python3 -c "import json,sys,os; d=json.load(open(os.environ['CFF_P'])); json.dump({'technologies': d.get('apps', d.get('technologies', {}))}, open(os.environ['FPTMP']+'.cff.json','w'))" 2>/dev/null || true
  fi
  [ -s ${FPTMP}.cff.json ] && CFF_OK=${FPTMP}.cff.json
fi
echo "[fp-scan] layer2: httpx + webappanalyzer(7613)..."
# F28: cff 格式与 httpx v1.10 wappalyzer loader 不兼容(四种重组实测全拒)。
# 务实降级: 先探测 cff 可载,失败则层2 用内置 wappalyzer 重跑交叉(标记 source=webappanalyzer-builtin),
# 绝不静默空转;扩展库兼容留待 httpx 升级。
L2_CFF=""
L2_SRC="webappanalyzer"
if [ -s "$CFF_OK" ]; then
  if echo "http://127.0.0.1:1" | timeout 10 httpx -silent -tech-detect -cff "$CFF_OK" -json >/dev/null 2>&1; then
    L2_CFF="-cff $CFF_OK"
  else
    echo "[fp-scan] layer2: cff 不兼容 httpx wappalyzer loader,降级内置引擎(交叉验证)" >&2
    L2_SRC="webappanalyzer-builtin"   # R32D57-NEW5: 溯源如实标注
  fi
fi
export L2_SRC
cat ${FPTMP}.in | httpx -silent -tech-detect -status-code \
  $L2_CFF -threads 15 -timeout 8 -json -o ${FPTMP}.l2.json >/dev/null 2>&1

echo "[fp-scan] layer3: whatweb(up to $MAX, version-strong)..."
head -$MAX ${FPTMP}.in > ${FPTMP}.ww
whatweb -q --no-errors --input-file ${FPTMP}.ww 2>/dev/null \
  | sed 's/\[200 OK\]\|\[301 Moved Permanently\]\|\[302 Found\]//g' \
  > ${FPTMP}.l3.txt || true

if [ "$DEEP" = "1" ]; then
  echo "[fp-scan] layer4(deep): nuclei fingerprint templates(以 fetch-fingerprints 实际交付为准)..."
  # R32D57-NEW3: 0x727 国产库模板不带 tech/fingerprint/panel tag(3577 实测
  # 零命中)——tags 过滤只适用于 nt-technologies;两库分跑, 否则 98.7% 被滤死。
  # NEW4: stdout 静音(此前原始 JSON 刷屏 1.3MB/2 发现)。
  nuclei -l ${FPTMP}.in -t "$NT_DIR/nt-technologies" \
    -severity info,low,medium,high,critical -tags tech,fingerprint,panel \
    -silent -nc -timeout 6 -retries 1 -rl 30 -c 20 -jsonl -o ${FPTMP}.l4.json >${FPTMP}.l4.log 2>&1 || true
  nuclei -l ${FPTMP}.in -t "$NT_DIR/plugins-0x727" \
    -severity info,low,medium,high,critical \
    -silent -nc -timeout 6 -retries 1 -rl 30 -c 20 -jsonl -o ${FPTMP}.l4b.json >${FPTMP}.l4b.log 2>&1 || true
  # R32D58-F7: nuclei 对 6s 超时目标标 unresponsive permanently 并静默
  # 清零——此后层产出为空时给一行 warn(日志落盘不刷屏, NEW4 制式保留)。
  UNRESP=$(grep -c 'unresponsive' ${FPTMP}.l4.log ${FPTMP}.l4b.log 2>/dev/null | awk -F: '{s+=$2} END{print s+0}')
  [ "$UNRESP" -gt 0 ] && echo "[fp-scan][warn] nuclei 标记 $UNRESP 条 unresponsive(超时目标被清零, 详见 nuclei 输出; 可提高 --timeout 或分批)" >&2
fi

FPTMP="$FPTMP" python3 - <<'PYEOF'  # CS31-P0: FPTMP 走环境变量(引号 heredoc 内 ${} 不展开)
import json, re, collections, os

apps = collections.defaultdict(set)   # asset -> {(app, source)}
meta = {}                             # asset -> {status,title,server}

def norm(u):
    u = u.strip()
    return re.sub(r'^https?://', '', u).rstrip('/')

for line in open(os.environ['FPTMP']+'.l1.json'):
    try: d = json.loads(line)
    except: continue
    a = norm(d.get('url', d.get('host', '')))
    if not a: continue
    m = meta.setdefault(a, {})
    m['status'] = d.get('status_code') or m.get('status')
    m['title'] = (d.get('title') or '').strip() or m.get('title')
    m['server'] = (d.get('webserver') or '').strip() or m.get('server')
    for t in d.get('tech', []) or []:
        apps[a].add((str(t), 'wappalyzer'))
    fh = d.get('favicon') or d.get('favicon_hash')
    if fh: m['favicon'] = str(fh)

for line in open(os.environ['FPTMP']+'.l2.json'):
    try: d = json.loads(line)
    except: continue
    a = norm(d.get('url', d.get('host', '')))
    for t in d.get('tech', []) or []:
        apps[a].add((str(t), os.environ.get('L2_SRC', 'webappanalyzer')))

# whatweb: "host [HTTP] field1, field2[key=val], ..."
for line in open(os.environ['FPTMP']+'.l3.txt'):
    line = line.strip()
    if not line: continue
    parts = re.split(r'\]\s*', line.replace('[', '', 1)) if ']' in line else [line]
    a = norm(parts[0])
    if len(parts) > 1:
        for fld in parts[1].split(','):
            fld = fld.strip().rstrip(']')
            if not fld or '=' in fld and re.match(r'^(HTTP|IP|Country|Email)', fld): continue
            if not re.match(r'^[A-Za-z][\w .:/-]{1,40}$', fld): continue
            apps[a].add((fld, 'whatweb'))

seen_now = set(meta) | set(apps)
# R32D57-NEW3: 两库分跑(l4=nt+tags 过滤, l4b=0x727 无过滤)
for _l4f in ('.l4.json', '.l4b.json'):
  if not os.path.exists(os.environ['FPTMP']+_l4f): continue
  for line in open(os.environ['FPTMP']+_l4f):
        try: d = json.loads(line)
        except: continue
        # F28: nuclei host 可能无端口/带 scheme——与 httpx 的 norm 键分裂,
        # 三级回退匹配: 精确 → 剥 scheme → 裸 host 前缀
        raw = str(d.get('host', ''))
        a = norm(raw)
        tid = d.get('template-id') or d.get('info', {}).get('name', '?')
        target = None
        if a in seen_now:
            target = a
        else:
            bare = a.split(':')[0]
            for cand in seen_now:
                if cand.split(':')[0] == bare:
                    target = cand; break
        if target:
            apps[target].add((f"{tid}", 'nuclei'))

seen = set(meta) | set(apps)
with open(os.environ['FPTMP']+'.out', 'w') as f:
    f.write("asset\tstatus\ttitle\tserver\tapps\tfav\tsource\n")
    for a in sorted(seen):
        m = meta.get(a, {})
        A = sorted({x[0] for x in apps[a]})
        S = sorted({x[1] for x in apps[a]}) or ['-']
        f.write(f"{a}\t{m.get('status','')}\t{m.get('title','')}\t{m.get('server','')}\t"
                f"{'; '.join(A) or '-'}\t{m.get('favicon','')}\t{','.join(S)}\n")
print(f"[fp-scan] done: {len(seen)} assets")
PYEOF

# F28: -o 生效——此前 OUT 变量解析了却从不写出
cp ${FPTMP}.out "$OUT" && echo "[fp-scan] output -> $OUT"

